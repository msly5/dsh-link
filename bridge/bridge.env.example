# Copy to ~/.config/dsh-remote/bridge.env (outside this repository), chmod 600.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD_64_HEX_CHARACTERS
DSH_PROXY_PORT=3079
# Normally auto-discovered; only pin if multiple DSH hosts are running.
# DSH_UPSTREAM_PORT=12345
# DSH_CREDENTIALS_FILE=/absolute/path/to/.dsh/.credentials.yaml
APNS_ENABLED=0
# Optional; see docs/push.md. Use absolute paths, not ~ or $HOME in env values.
# APNS_KEY_ID=YOUR_KEY_ID
# APNS_TEAM_ID=YOUR_TEAM_ID
# APNS_TOPIC=com.example.yourname.dshremote
# APNS_KEY_FILE=/absolute/path/to/private/apns.p8
# APNS_ENV=development
